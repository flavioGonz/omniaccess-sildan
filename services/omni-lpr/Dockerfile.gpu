# Omni-LPR (lector de matrículas) sobre la GPU: el mismo servidor de omni-lpr, con ONNX Runtime
# con CUDA. Vivía sólo en /opt/omni-lpr del servidor de San Nicolás, creado a mano: una
# instalación nueva no tenía de dónde sacarlo. Es la misma receta, versionada.
#
# onnxruntime-gpu 1.30 pide CUDA 13 y cuDNN 9 (con una base CUDA 12 carga igual y cae a CPU en
# silencio: «libcublasLt.so.13: cannot open shared object file»). Driver del host: 595.91 o más.
FROM nvidia/cuda:13.0.2-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive PIP_BREAK_SYSTEM_PACKAGES=1
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip curl \
      libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 libxcb1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --default-timeout=120 "omni-lpr" \
 && pip uninstall -y onnxruntime \
 && pip install --no-cache-dir --default-timeout=120 onnxruntime-gpu

ENV OMNI_LPR_HOST=0.0.0.0 OMNI_LPR_PORT=8000 EXECUTION_DEVICE=cuda \
    OMP_NUM_THREADS=4
EXPOSE 8000
CMD ["omni-lpr", "--host", "0.0.0.0", "--port", "8000"]
