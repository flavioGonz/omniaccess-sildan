generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id        String      @id @default(cuid())
  plate     String      @unique
  type      VehicleType @default(SEDAN)
  brand     String?
  model     String?
  color     String?
  imagePath String?
  notes     String?
  userId    String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Unit {
  id           String        @id @default(cuid())
  name         String
  description  String?
  type         UnitType      @default(EDIFICIO)
  number       String        @default("")
  floors       Int?
  lot          String?
  houseNumber  String?
  address      String?
  coordinates  String?
  mapPoints    String?
  contactName  String?
  contactEmail String?
  adminPhone   String?
  deviceCount  Int           @default(0)
  deviceType   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  parentId     String?
  parkingSlots ParkingSlot[]
  parent       Unit?         @relation("SubUnits", fields: [parentId], references: [id])
  children     Unit[]        @relation("SubUnits")
  users        User[]
}

model User {
  id              String        @id @default(cuid())
  name            String
  username        String?       @unique
  email           String?
  phone           String?
  dni             String?
  cara            String?
  unitId          String?
  apartment       String?
  parkingSlotId   String?       @unique
  role            UserRole      @default(RESIDENT)
  accessTags      String[]      @default([])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  observations    String?
  blacklistReason String?
  createdBy       String?
  accessEvents    AccessEvent[]
  credentials     Credential[]
  parkingSlot     ParkingSlot?  @relation(fields: [parkingSlotId], references: [id])
  unit            Unit?         @relation(fields: [unitId], references: [id])
  vehicles        Vehicle[]
  accessGroups    AccessGroup[] @relation("AccessGroupToUser")
}

model Credential {
  id    String         @id @default(cuid())
  type  CredentialType
  value String
  notes String?

  // Sin dueno todavia.
  //
  // Antes era obligatorio, y la pantalla de tags igual ofrecia "dejar en el cajon": para
  // eso las acciones escribian userId = "", que es una cadena vacia y no el id de nadie.
  // La clave foranea lo rechazaba, el error caia en un catch que solo lo escribia en la
  // consola del servidor, y el boton quedaba sin hacer nada y sin decirlo. O sea que dar
  // de alta una tarjeta sin asignar y desasignar una tarjeta nunca funcionaron.
  //
  // El caso es real y hay que poder representarlo: se compran cincuenta tarjetas, se
  // cargan, y despues se reparten. Nulo es "todavia de nadie"; cadena vacia no significa
  // nada en ningun lado.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccessGroup {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  schedules Schedule[]
  devices   Device[]   @relation("AccessGroupToDevice")
  users     User[]     @relation("AccessGroupToUser")
}

model Schedule {
  id            String      @id @default(cuid())
  accessGroupId String
  days          DayOfWeek[]
  startTime     String
  endTime       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  accessGroup   AccessGroup @relation(fields: [accessGroupId], references: [id], onDelete: Cascade)
}

model FloorPlan {
  id        String   @id @default(cuid())
  name      String
  imagePath String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  devices   Device[]
}

model Device {
  id              String           @id @default(cuid())
  name            String
  deviceType      DeviceType       @default(LPR_CAMERA)
  brand           DeviceBrand
  deviceModel     String?
  modelPhoto      String?
  brandLogo       String?
  ip              String
  mac             String?
  location        String?
  direction       DeviceDirection  @default(ENTRY)
  doorStatus      DoorStatus       @default(UNKNOWN)
  authType        AuthType         @default(BASIC)
  username        String?
  password        String?
  lastOnlinePull  DateTime?
  lastOnlinePush  DateTime?
  floorPlanId     String?
  mapX            Float?
  mapY            Float?
  // Camaras interiores: la pasarela de seguimiento toma cuadros de este RTSP
  // y se los manda al contenedor Omni-LPR.
  rtspUrl         String?
  trackScene      Float?
  trackEnabled    Boolean          @default(true)
  // Calibracion de la camara interior: zona de interes (JSON {x,y,w,h} en 0..1),
  // confianza minima propia y cuadros por segundo a muestrear.
  trackRoi        String?
  // "escena": ffmpeg decide mirando el cambio de imagen (sirve en cualquier camara).
  // "camara": la propia camara avisa que paso un vehiculo (AcuSense) y recien ahi
  // se leen cuadros. Mucho mas preciso y deja la GPU en reposo el resto del tiempo.
  trackTrigger    String?          @default("escena")
  // Linea de pasada, cuando el disparo es por cruce: {x1,y1,x2,y2,sentido} en fracciones
  // del cuadro. Una linea es mejor que una zona para una calle: dispara en el instante
  // del cruce, y un auto estacionado adentro del encuadre deja de importar.
  trackLine       String?
  trackMinConf    Float?
  trackFps        Float?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accessEvents    AccessEvent[]
  callEvents      CallEvent[]
  floorPlan       FloorPlan?       @relation(fields: [floorPlanId], references: [id])
  hardwareMirrors HardwareMirror[]
  queueEvents     QueueEvent[]
  queueAlerts     QueueAlert[]
  accessGroups    AccessGroup[]    @relation("AccessGroupToDevice")
  franja          Franja?
  ocupaciones     Ocupacion[]
}

model AccessEvent {
  id            String          @id @default(cuid())
  timestamp     DateTime
  accessType    CredentialType?
  credentialId  String?
  userId        String?
  deviceId      String?
  imagePath     String?
  decision      AccessDecision
  plateDetected String?
  direction     DeviceDirection @default(ENTRY)
  location      String?
  snapshotPath  String?
  plateNumber   String?
  details       String?
  createdAt     DateTime        @default(now())
  device        Device?         @relation(fields: [deviceId], references: [id], map: "AccessEvent_deviceId_fkey_v2")
  user          User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bitacora      Bitacora?

  // La presencia por lote y el historial de una matrícula consultan por estos campos.
  @@index([plateDetected, timestamp])
  @@index([timestamp])
}

model Bitacora {
  id            String       @id @default(cuid())
  timestamp     DateTime     @default(now())
  type          String
  plate         String?
  photoPath     String?
  notes         String?
  name          String?
  dni           String?
  company       String?
  destination   String?
  guardName     String?
  latitude      Float?
  longitude     Float?
  audioPath     String?
  accessEventId String?      @unique
  accessEvent   AccessEvent? @relation(fields: [accessEventId], references: [id])
}

model CallEvent {
  id         String   @id @default(cuid())
  timestamp  DateTime
  deviceId   String
  callerName String?
  callerId   String?
  calleeName String?
  calleeId   String?
  duration   Int      @default(0)
  status     String
  direction  String
  createdAt  DateTime @default(now())
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model HardwareMirror {
  id          String   @id @default(cuid())
  deviceId    String
  hardwareId  String
  name        String?
  cardCode    String?
  pin         String?
  faceUrl     String?
  syncStatus  String   @default("IN_SYNC")
  lastUpdated DateTime @default(now())
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, hardwareId])
}

model Setting {
  key       String   @id @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParkingSlot {
  id         String   @id @default(cuid())
  x          Float    @default(0)
  y          Float    @default(0)
  width      Float    @default(0)
  height     Float    @default(0)
  label      String
  isOccupied Boolean  @default(false)
  points     String?
  unitId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  unit       Unit?    @relation(fields: [unitId], references: [id])
  user       User?
}

model TopologyNode {
  id        String   @id @unique
  x         Float
  y         Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsAppSession {
  phoneNumber String   @id
  step        String
  data        String?
  updatedAt   DateTime @updatedAt
}

model WahaRequestLog {
  id              String   @id @default(cuid())
  timestamp       DateTime @default(now())
  fromNumber      String
  messageBody     String
  status          String
  responseDetails String?
}

// ─── Queue / Line Counting Module ────────────────────────────────
model QueueEvent {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  channelName  String?
  channelId    Int?
  peopleCount  Int
  regionId     String?
  snapshotPath String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([deviceId])
  @@index([timestamp])
  @@index([deviceId, channelName])
}

model QueueAlert {
  id          String    @id @default(cuid())
  name        String
  deviceId    String?
  device      Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  channelName String?
  threshold   Int
  enabled     Boolean   @default(true)
  cooldownMin Int       @default(5)
  cooldownSec Int?
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deviceId])
}

model PendingRegistration {
  id        String   @id @default(cuid())
  type      String
  data      Json
  guardName String
  status    String   @default("PENDING")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VehicleType {
  SEDAN
  SUV
  PICKUP
  VAN
  TRUCK
  MOTORCYCLE
}

enum UnitType {
  BARRIO
  EDIFICIO
  CASA
}

enum UserRole {
  RESIDENT
  VISITOR
  STAFF
  ADMIN
  PROVIDER
  TEMPORARY_VISITOR
  BLACKLISTED
  WHITELISTED
  SECURITY
  OPERATOR
}

enum CredentialType {
  PLATE
  FACE
  TAG
  PIN
  PASSWORD
  FINGERPRINT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DeviceType {
  LPR_CAMERA
  LPR_INTERIOR
  NVR
  FACE_TERMINAL
  ACCESS_CONTROL
  DOOR_INTERCOM
  QUEUE_COUNTER
}

enum DeviceBrand {
  /// Sin marca conocida: lo unico que se le pide es el flujo RTSP. Ver SOPORTE en
  /// src/lib/drivers/catalogo.ts.
  GENERICA
  HIKVISION
  AKUVOX
  INTELBRAS
  DAHUA
  ZKTECO
  AVICAM
  MILESIGHT
  UNIFI
  UNIVIEW
  BOSCH
  AXIS
}

enum AuthType {
  NONE
  BASIC
  DIGEST
}

enum DoorStatus {
  OPEN
  CLOSED
  UNKNOWN
}

enum DeviceDirection {
  ENTRY
  EXIT
}

enum AccessDecision {
  GRANT
  DENY
}

// ─── Notification Channels ───────────────────────────────
model NotificationChannel {
  id        String   @id @default(cuid())
  name      String
  type      String // TELEGRAM, EMAIL, SLACK, WEBHOOK
  config    String // JSON: { token, chatId } | { email } | { webhookUrl } | { slackUrl }
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs NotificationLog[]

  @@index([type])
}

model NotificationLog {
  id        String              @id @default(cuid())
  channelId String
  channel   NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  alertId   String?
  message   String
  status    String // SENT, FAILED, PENDING
  error     String?
  metadata  String? // JSON with extra context
  createdAt DateTime            @default(now())

  @@index([channelId])
  @@index([createdAt])
  @@index([status])
}

model QueueSchedule {
  id          String    @id @default(cuid())
  name        String
  deviceId    String?
  daysOfWeek  String    @default("1,2,3,4,5,6,7")
  openTime    String    @default("08:00")
  closeTime   String    @default("20:00")
  resetOnOpen Boolean   @default(true)
  enabled     Boolean   @default(true)
  lastResetAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CameraOutage {
  id          String    @id @default(cuid())
  deviceId    String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int?
  lastValue   Int?
  createdAt   DateTime  @default(now())

  @@index([deviceId])
  @@index([startedAt])
  @@index([deviceId, endedAt])
}

// ── Notificaciones: reglas/criterios de notificación (config) ──────────────
model NotificationRule {
  id          String    @id @default(cuid())
  name        String
  enabled     Boolean   @default(true)
  // Modulo al que aplica la regla y, para LPR/FACE, que eventos la disparan.
  // QUEUE usa metric/operator/threshold; LPR y FACE usan eventos.
  modulo      String    @default("QUEUE") // QUEUE | LPR | FACE
  eventos     String? // csv: ALLOW,DENY,UNKNOWN,WATCHLIST
  deviceId    String? // null = todas las cámaras
  channelName String? // zona/canal ("Aforo","Entrada","Salida"); null = cualquiera
  metric      String    @default("aforo") // aforo | entrada | salida
  operator    String    @default(">=") // >= | > | == | <=
  threshold   Int       @default(1)
  daysOfWeek  String    @default("1,2,3,4,5,6,7")
  startTime   String    @default("00:00")
  endTime     String    @default("23:59")
  channels    String    @default("telegram") // csv: telegram,email,...
  minSeverity String? // ok | warn | full | critico (gate opcional)
  cooldownSec Int       @default(60)
  dedupe      Boolean   @default(true)
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([enabled])
  @@index([deviceId])
}

// ── Despachos: cola/outbox de envíos con estado y reintentos ───────────────
model DispatchJob {
  id          String    @id @default(cuid())
  type        String // ALERT | REPORT
  channel     String // telegram | email | ...
  status      String    @default("PENDING") // PENDING|PROCESSING|SENT|FAILED|CANCELLED
  payload     Json
  ruleId      String?
  deviceId    String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  sentAt      DateTime?
  bullJobId   String? // id del job en BullMQ para correlación
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([type])
  @@index([scheduledAt])
  @@index([createdAt])
}

// ── Reportes programados (config, autogestionable desde la UI) ──────────────
model ReportSchedule {
  id        String    @id @default(cuid())
  name      String
  enabled   Boolean   @default(true)
  frequency String    @default("daily") // daily | weekly
  time      String    @default("22:00") // HH:MM hora de envío
  dayOfWeek Int       @default(7) // 1-7 (solo weekly; 7=domingo)
  period    String    @default("daily") // ventana del reporte: daily | weekly
  deviceId  String?
  channel   String    @default("telegram")
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([enabled])
}

// ── Salud de dispositivos: muestreo histórico + alertas (health tick 24/7) ──
model DeviceHealthSample {
  id        String   @id @default(cuid())
  deviceId  String
  ts        DateTime @default(now())
  reachable Boolean
  latencyMs Int?
  memPct    Int?
  uptimeSec Int?
  driftSec  Int?
  disksOk   Boolean?
  viewers   Int?

  @@index([deviceId, ts])
}

model DeviceAlert {
  id         String    @id @default(cuid())
  deviceId   String
  type       String // offline | disk | mem | drift
  severity   String    @default("warning") // warning | critical
  message    String
  openedAt   DateTime  @default(now())
  resolvedAt DateTime?
  active     Boolean   @default(true)

  @@index([active])
  @@index([deviceId])
}

// ── Watchlist / lista negra de matrículas (resaltado + sonido + alerta) ──
model PlateWatch {
  id        String   @id @default(cuid())
  plate     String   @unique
  label     String   @default("")
  category  String   @default("negra") // busca | negra | vip
  color     String?
  notify    Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Avistamiento de una matricula en una camara, con la posicion de esa camara
/// congelada en el momento (si la camara se mueve despues, el historial no cambia).
/// Alimenta el recorrido del vehiculo dentro del barrio.
model PlateSighting {
  id            String   @id @default(cuid())
  plate         String
  deviceId      String?
  cameraName    String?
  lat           Float?
  lng           Float?
  timestamp     DateTime
  source        String   @default("LPR") // LPR | TRACK (camara comun + Omni-LPR)
  eventType     String? // ENTRY | EXIT | INTERNAL | MOTION
  decision      String? // GRANT | DENY | UNKNOWN
  confidence    Float?
  snapshotUrl   String?
  accessEventId String?  @unique
  createdAt     DateTime @default(now())

  // Cuantos cuadros de la rafaga coincidieron en esta lectura. Una matricula
  // vista en cinco cuadros seguidos vale mucho mas que una vista en uno solo,
  // y es lo que permite separar una lectura buena de un invento del OCR.
  reads Int?

  // Donde aparecio la chapa dentro del cuadro, en fracciones {x,y,w,h}. Es la senal que
  // distingue un vehiculo que pasa de uno estacionado: el que pasa mueve el recuadro
  // entre una lectura y la siguiente; el que esta quieto lo deja en el mismo lugar.
  bbox String?

  // PASO o ESTACIONADO. Un auto quieto dentro del encuadre se relee con cada vehiculo
  // que pasa: tratarlo como avistamiento nuevo llenaba el historial de repeticiones y
  // dibujaba recorridos que nunca ocurrieron. Ahora es UNA fila por estadia, con su
  // intervalo, que se va extendiendo mientras el auto siga ahi.
  estado     String    @default("PASO")
  estDesde   DateTime?
  estHasta   DateTime?
  // Si ya se aviso que estaciono. Una estadia recien nacida todavia puede ser un auto
  // detenido un momento; el aviso sale cuando la estadia se consolida.
  estAvisado Boolean   @default(false)
  // Si la estadia ya se cerro (el vehiculo se fue). Un auto que se va no genera ninguna
  // lectura: se nota por ausencia, y lo cierra el barrendero.
  estCerrada Boolean   @default(false)

  passId String?
  pass   VehiclePass? @relation(fields: [passId], references: [id], onDelete: SetNull)

  @@index([passId])
  @@index([estado, timestamp])
  @@index([plate, timestamp])
  @@index([timestamp])
  @@index([deviceId, timestamp])
}

/// Un paso del vehiculo por el barrio: agrupa los avistamientos de una misma
/// matricula que ocurren cerca en el tiempo. El mapa dibuja trayectos, no puntos
/// sueltos, y la pantalla puede decir "entro 12:35, paso por Calle 21, salio 12:41"
/// en vez de mostrar una lista plana que con volumen se vuelve ilegible.
model VehiclePass {
  id        String          @id @default(cuid())
  plate     String
  startedAt DateTime
  endedAt   DateTime
  sightings PlateSighting[]
  createdAt DateTime        @default(now())

  @@index([plate, startedAt])
  @@index([startedAt])
}

/// Una muestra por minuto del estado del seguimiento. El panel dejaba ver solo la foto
/// del instante, que no sirve para decidir nada: si la GPU esta al 10% ahora no dice si
/// estuvo al 90% hace media hora, ni si el lector viene leyendo o hace rato que no.
/// Se guardan dos semanas y se borra lo viejo en la misma pasada.
model TrackingSample {
  id        String   @id @default(cuid())
  momento   DateTime @default(now())
  gpuUso    Int?
  gpuMem    Int?
  gpuTemp   Int?
  gpuWatts  Int?
  cpuCont   Float?
  memCont   Int? // MB
  camaras   Int?
  disparos  Int? // rafagas abiertas desde la muestra anterior
  lecturas  Int? // avistamientos aceptados
  descartes Int? // rafagas que no dieron una lectura confiable
  enGpu     Boolean?

  @@index([momento])
}

/// Una muestra por camara y por minuto del trabajo del lector.
///
/// TrackingSample guarda lo mismo pero sumado: sirve para ver si el motor esta leyendo,
/// no para saber CUAL camara dejo de leer. Y esa es justo la pregunta que se hace cuando
/// el numero baja.
///
/// El denominador es la RAFAGA, no el evento. En la barrera el denominador viene solo
/// porque la camara escribe NO_LEIDA cuando no reconoce; en seguimiento una rafaga seca
/// no deja ninguna fila, asi que contar avistamientos daria un numerador sin denominador.
///
/// Sin relacion a Device a proposito: si mañana se da de baja una camara, su historial de
/// rendimiento tiene que sobrevivir — es el registro de como venia funcionando, y suele
/// ser lo primero que se quiere mirar justo despues de sacarla. Por eso ademas se guarda
/// el nombre: sin el, una fila de una camara borrada seria un cuid sin significado.
model TrackingCamaraMuestra {
  id           String   @id @default(cuid())
  momento      DateTime @default(now())
  deviceId     String
  nombre       String?
  /// Rafagas abiertas en el minuto. Es el denominador de la tasa.
  disparos     Int      @default(0)
  /// Rafagas que dieron un avistamiento aceptado. Un auto ya estacionado que se relee no
  /// cuenta: mediria el estacionamiento y no el trabajo del lector.
  lecturas     Int      @default(0)
  /// Rafagas que no dieron una lectura confiable.
  descartes    Int      @default(0)
  /// Lecturas buenas descartadas por caer fuera de la zona o la linea. No son un fallo
  /// del lector: son una decision del calibrador, y confundirlas hunde la tasa sin motivo.
  fueraDeLinea Int      @default(0)
  /// Disparos que no se hicieron por falta de cuota. Explican una tasa que no baja pero
  /// un conteo que si.
  frenados     Int      @default(0)

  @@index([momento])
  @@index([deviceId, momento])
}

// ---------------------------------------------------------------------------
// La franja de estacionamiento de una camara.
//
// Por que existe esto, y por que reemplaza al criterio anterior:
//
// Hasta ahora la estadia colgaba de la CHAPA, y la unica prueba de que un auto seguia
// ahi era otra lectura de la misma chapa. Pero una lectura es un evento sobre una chapa
// que cruzo el cuadro: no dice nada sobre si el vehiculo esta quieto. El parche de la
// vigilia intento tapar ese hueco comparando los pixeles alrededor del ultimo recuadro,
// y ahi aparecio el falso positivo: un pedazo de calle vacia tambien se ve igual de una
// mirada a la otra, asi que "no cambio nada" se leia como "el auto sigue".
//
// En treinta horas de Calle 22 eso produjo SIETE estadias para AAU9032 — un solo auto
// que no se movio nunca — y en Calle 21 el mismo auto figuro como tres (SDM1707,
// SDH1707, 5DH177) porque el OCR lo leyo distinto cada vez.
//
// La franja cambia el sujeto de la pregunta: la estadia pasa a ser del LUGAR.
// "Esta ocupado este poligono?" si se puede contestar con pixeles, porque el poligono no
// se mueve nunca y su aspecto vacio se puede aprender. Ocupado contra vacio es una
// diferencia enorme; "cambio este recorte?" es una diferencia minima. La chapa pasa a
// NOMBRAR al ocupante, no a probarlo.
// ---------------------------------------------------------------------------
model Franja {
  id       String  @id @default(cuid())
  deviceId String  @unique
  device   Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  nombre   String?

  // Cuatro esquinas en fracciones del cuadro, en orden a, b, c, d: a→b es un lado largo
  // de la franja y d→c el opuesto. La celda i va de lerp(a,b) a lerp(d,c), asi que las
  // celdas se achican solas hacia el fondo — igual que los autos en perspectiva. Un
  // rectangulo con lados iguales no serviria: una calle se ve en diagonal.
  esquinas String

  // Cuantos autos entran en la franja. No se deduce: no hay escala en la imagen, y
  // deducirla de la chapa ya fallo antes (ver arquitectura §3.11). Lo sabe el operador
  // mirando la calle, y es el unico numero que tiene que poner.
  lugares Int @default(6)

  // La huella de cada celda con la franja vacia, aprendida a pedido del operador.
  // JSON [[n,...],...]. Mientras sea null la franja no mide nada y lo dice: inventar una
  // referencia es exactamente el error que produjo los fantasmas.
  vacio   String?
  vacioAt DateTime?

  activa      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  ocupaciones Ocupacion[]
}

// Una estadia, que ahora es de un lugar de la franja y no de una matricula.
model Ocupacion {
  id       String @id @default(cuid())
  franjaId String
  franja   Franja @relation(fields: [franjaId], references: [id], onDelete: Cascade)
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  lugar    Int

  // Quien es. Puede quedar en null: un auto ocupa el lugar aunque no se le lea la chapa.
  plate      String?
  plateConf  Float?
  sightingId String?

  desde   DateTime
  hasta   DateTime
  cerrada Boolean  @default(false)
  avisado Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([franjaId, lugar, cerrada])
  @@index([deviceId, cerrada])
  @@index([plate])
}
