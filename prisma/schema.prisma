generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id        String      @id @default(cuid())
  plate     String      @unique
  type      VehicleType @default(SEDAN)
  brand     String?
  model     String?
  color     String?
  imagePath String?
  notes     String?
  userId    String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Unit {
  id           String        @id @default(cuid())
  name         String
  description  String?
  type         UnitType      @default(EDIFICIO)
  number       String        @default("")
  floors       Int?
  lot          String?
  houseNumber  String?
  address      String?
  coordinates  String?
  mapPoints    String?
  contactName  String?
  contactEmail String?
  adminPhone   String?
  deviceCount  Int           @default(0)
  deviceType   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  parentId     String?
  parkingSlots ParkingSlot[]
  parent       Unit?         @relation("SubUnits", fields: [parentId], references: [id])
  children     Unit[]        @relation("SubUnits")
  users        User[]
}

model User {
  id              String        @id @default(cuid())
  name            String
  email           String?
  phone           String?
  dni             String?
  cara            String?
  unitId          String?
  apartment       String?
  parkingSlotId   String?       @unique
  role            UserRole      @default(RESIDENT)
  accessTags      String[]      @default([])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  blacklistReason String?
  createdBy       String?
  observations    String?
  username        String?       @unique
  accessEvents    AccessEvent[]
  credentials     Credential[]
  parkingSlot     ParkingSlot?  @relation(fields: [parkingSlotId], references: [id])
  unit            Unit?         @relation(fields: [unitId], references: [id])
  vehicles        Vehicle[]
  accessGroups    AccessGroup[] @relation("AccessGroupToUser")
}

model Credential {
  id        String         @id @default(cuid())
  type      CredentialType
  value     String
  notes     String?
  userId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccessGroup {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  schedules Schedule[]
  devices   Device[]   @relation("AccessGroupToDevice")
  users     User[]     @relation("AccessGroupToUser")
}

model Schedule {
  id            String      @id @default(cuid())
  accessGroupId String
  days          DayOfWeek[]
  startTime     String
  endTime       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  accessGroup   AccessGroup @relation(fields: [accessGroupId], references: [id], onDelete: Cascade)
}

model FloorPlan {
  id        String   @id @default(cuid())
  name      String
  imagePath String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  devices   Device[]
}

model Device {
  id              String           @id @default(cuid())
  name            String
  deviceType      DeviceType       @default(LPR_CAMERA)
  brand           DeviceBrand
  deviceModel     String?
  modelPhoto      String?
  brandLogo       String?
  ip              String
  mac             String?
  location        String?
  direction       DeviceDirection  @default(ENTRY)
  doorStatus      DoorStatus       @default(UNKNOWN)
  authType        AuthType         @default(BASIC)
  username        String?
  password        String?
  lastOnlinePull  DateTime?
  lastOnlinePush  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  floorPlanId     String?
  mapX            Float?
  mapY            Float?
  accessEvents    AccessEvent[]
  callEvents      CallEvent[]
  floorPlan       FloorPlan?       @relation(fields: [floorPlanId], references: [id])
  hardwareMirrors HardwareMirror[]
  accessGroups    AccessGroup[]    @relation("AccessGroupToDevice")
}

model AccessEvent {
  id            String          @id @default(cuid())
  timestamp     DateTime
  accessType    CredentialType?
  credentialId  String?
  userId        String?
  deviceId      String?
  imagePath     String?
  decision      AccessDecision
  plateDetected String?
  direction     DeviceDirection @default(ENTRY)
  location      String?
  snapshotPath  String?
  plateNumber   String?
  details       String?
  createdAt     DateTime        @default(now())
  device        Device?         @relation(fields: [deviceId], references: [id], map: "AccessEvent_deviceId_fkey_v2")
  user          User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bitacora      Bitacora?
}

model Bitacora {
  id            String       @id @default(cuid())
  timestamp     DateTime     @default(now())
  type          String
  plate         String?
  photoPath     String?
  notes         String?
  name          String?
  dni           String?
  company       String?
  destination   String?
  guardName     String?
  latitude      Float?
  longitude     Float?
  audioPath     String?
  accessEventId String?      @unique
  accessEvent   AccessEvent? @relation(fields: [accessEventId], references: [id])
}

model CallEvent {
  id         String   @id @default(cuid())
  timestamp  DateTime
  deviceId   String
  callerName String?
  callerId   String?
  calleeName String?
  calleeId   String?
  duration   Int      @default(0)
  status     String
  direction  String
  createdAt  DateTime @default(now())
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model HardwareMirror {
  id          String   @id @default(cuid())
  deviceId    String
  hardwareId  String
  name        String?
  cardCode    String?
  pin         String?
  faceUrl     String?
  syncStatus  String   @default("IN_SYNC")
  lastUpdated DateTime @default(now())
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, hardwareId])
}

model Setting {
  key       String   @id @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParkingSlot {
  id         String   @id @default(cuid())
  x          Float    @default(0)
  y          Float    @default(0)
  width      Float    @default(0)
  height     Float    @default(0)
  label      String
  isOccupied Boolean  @default(false)
  points     String?
  unitId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  unit       Unit?    @relation(fields: [unitId], references: [id])
  user       User?
}

model TopologyNode {
  id        String   @id @unique
  x         Float
  y         Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsAppSession {
  phoneNumber String   @id
  step        String
  data        String?
  updatedAt   DateTime @updatedAt
}

model WahaRequestLog {
  id              String   @id @default(cuid())
  timestamp       DateTime @default(now())
  fromNumber      String
  messageBody     String
  status          String
  responseDetails String?
}

enum VehicleType {
  SEDAN
  SUV
  PICKUP
  VAN
  TRUCK
  MOTORCYCLE
}

enum UnitType {
  BARRIO
  EDIFICIO
  CASA
}

enum UserRole {
  RESIDENT
  VISITOR
  STAFF
  ADMIN
  PROVIDER
  TEMPORARY_VISITOR
  BLACKLISTED
  WHITELISTED
  SECURITY
}

enum CredentialType {
  PLATE
  FACE
  TAG
  PIN
  FINGERPRINT
  PASSWORD
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DeviceType {
  LPR_CAMERA
  FACE_TERMINAL
  ACCESS_CONTROL
  DOOR_INTERCOM
}

enum DeviceBrand {
  HIKVISION
  AKUVOX
  INTELBRAS
  DAHUA
  ZKTECO
  AVICAM
  MILESIGHT
  UNIFI
  UNIVIEW
}

enum AuthType {
  NONE
  BASIC
  DIGEST
}

enum DoorStatus {
  OPEN
  CLOSED
  UNKNOWN
}

enum DeviceDirection {
  ENTRY
  EXIT
}

enum AccessDecision {
  GRANT
  DENY
}
